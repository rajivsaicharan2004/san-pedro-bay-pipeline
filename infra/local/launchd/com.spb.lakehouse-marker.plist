<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spb.lakehouse-marker</string>
    <!-- Stands in for infra/oci/scripts/sync_lakehouse.sh: in the cloud
         deployment, Dagster's sensor (orchestration/spb_orchestration/sensors.py)
         watches this file's mtime to know when a real OCI sync just
         happened. Locally, dbt already reads MinIO directly and live (no
         sync/mirror step exists or is needed), so this timer just touches
         the same marker on an interval, turning the existing sensor into
         a plain "rebuild every 5 minutes" trigger without changing any
         Dagster code between the two deployment modes. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/touch</string>
        <string>/Users/jo/spb_local/lakehouse_marker/.last_synced</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jo/spb_local/logs/lakehouse_marker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jo/spb_local/logs/lakehouse_marker.log</string>
</dict>
</plist>
