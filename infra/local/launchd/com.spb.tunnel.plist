<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spb.tunnel</string>
    <!-- ngrok reserved domain: unlike the Cloudflare quick tunnel this
         replaced, the URL is stable across restarts/reboots -- always
         https://playpen-wreckage-abiding.ngrok-free.dev. Requires the
         authtoken already saved to
         ~/Library/Application Support/ngrok/ngrok.yml (ngrok config
         add-authtoken ...) and the domain reserved on the ngrok account
         (dashboard.ngrok.com/domains). -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/ngrok</string>
        <string>http</string>
        <string>--url=https://playpen-wreckage-abiding.ngrok-free.dev</string>
        <string>8501</string>
        <string>--log=stdout</string>
        <string>--log-format=logfmt</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jo</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/jo/spb_local/logs/tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jo/spb_local/logs/tunnel.log</string>
</dict>
</plist>
