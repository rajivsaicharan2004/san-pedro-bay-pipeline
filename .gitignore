.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
processing/geofences/data/
processing/streaming/data/
processing/streaming/processing/

# dbt -- generated database, logs, and compiled artifacts, not source.
dbt/.venv/
dbt/target/
dbt/logs/
dbt/*.duckdb
dbt/*.duckdb.wal
dbt/.user.yml

# Dagster -- its own venv, plus DAGSTER_HOME lives outside the repo
# entirely (/home/ubuntu/dagster_home on the instance) so no run/event
# storage ever ends up in here.
orchestration/.venv/

# Streamlit -- local secrets.toml is for testing only; the real deploy
# uses Streamlit Community Cloud's own Secrets UI, never a committed file.
dashboard/.streamlit/secrets.toml

# Terraform -- state/plans have resource details, tfvars/backend.hcl have
# account-specific (OCID/namespace) values neither belongs in git.
infra/oci/.terraform/
infra/oci/terraform.tfstate*
infra/oci/*.tfplan
infra/oci/crash.log
infra/oci/terraform.tfvars
infra/oci/backend.hcl
infra/oci/retry_apply.log
infra/aws/.terraform/
infra/aws/terraform.tfstate*
infra/aws/*.tfplan
infra/aws/crash.log
infra/aws/terraform.tfvars
infra/aws/backend.hcl
